<?xml version="1.0" encoding="utf-8"?>
<package>
  <metadata>
    <id>EasyApiProxy.Core</id>
    <version>4.6.2</version>
    <title>EasyApiProxy.Core</title>
    <authors>Shengwen2000</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/shengwen2000/EasyInjector</projectUrl>
    <description>WebApi 的快速代理類別 (支援 .NET 8 與 .NET Framework 4.7.2)</description>
    <copyright>copyright</copyright>
    <readme>docs\EasyApiProxy.md</readme>
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.Extensions.DependencyInjection" version="8.0.1" />
        <dependency id="EasyInjector.DependencyInjection" version="1.6.8" />
      </group>
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="Microsoft.Extensions.DependencyInjection" version="8.0.1" />
        <dependency id="EasyInjector.DependencyInjection" version="1.6.8" />
        <dependency id="System.Reflection.DispatchProxy" version="4.7.1" />
        <dependency id="System.Text.Json" version="8.0.5" />
      </group>
    </dependencies>
    <tags>WebAPI Proxy</tags>
  </metadata>

  <files>
    <file src="..\..\EasyApiProxy.md" target="docs\" />
    <file src="bin\Release\net8.0\EasyApiProxy.Core.dll" target="lib\net8.0\EasyApiProxy.Core.dll" />
    <file src="bin\Release\net8.0\EasyApiProxy.Core.xml" target="lib\net8.0\EasyApiProxy.Core.xml" />
    <file src="bin\Release\net472\EasyApiProxy.Core.dll" target="lib\net472\EasyApiProxy.Core.dll" />
    <file src="bin\Release\net472\EasyApiProxy.Core.xml" target="lib\net472\EasyApiProxy.Core.xml" />
  </files>
</package>